{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sabermetrics-api-edge-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Keep shared origin as the wrangler default until dedicated DNS + LE TLS
  // are Ready. Dashboard may override ORIGIN; do not point ORIGIN at the
  // dedicated host until sabermetrics-sandbox-api.botstacks.ai resolves and
  // serves a trusted cert. Never attach this Worker as a route on the
  // dedicated origin hostname (orange-to-orange loop).
  "vars": {
    "ORIGIN": "https://sandbox-api.botstacks.ai",
    "ALLOWED_ORIGINS": "https://sabermetrics-staging.webflow.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  // Staging abuse control only — authoritative quotas remain in the API ledger.
  // namespace_id must stay unique on the BOTSTACKS Cloudflare account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1197",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
