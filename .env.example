# ---------------------------------------------------------------------------
# Sabermetrics AI — frontend configuration
#
# Everything here is PUBLIC. Vite inlines every VITE_* value into the client
# bundle, so never put a private BotStacks token, workspace key, or LLM API key
# in this file. The BotStacks web widget is deliberately credential-free: it is
# authenticated by nothing but the published bot's public UUID.
# ---------------------------------------------------------------------------

# Public UUID of the published BotStacks assistant that powers the page.
# Dashboard -> your assistant -> Activate/Embed -> the `data-bot` value in the
# generated <script> snippet. Without this the site renders a "not configured"
# state instead of a broken chat.
VITE_BOTSTACKS_BOT_ID=

# Production BotStacks API origin. Leave unset to use https://api.botstacks.ai.
# Only override this if you are pointing at another production deployment.
# VITE_BOTSTACKS_API_ORIGIN=https://api.botstacks.ai

# Optional: repository link shown in the header/footer.
# VITE_GITHUB_URL=https://github.com/BotStacks/sabermetrics-ai
